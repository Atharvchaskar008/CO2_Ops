# =============================================================================
# CO2Ops - Google ADK & Gemini Environment Configuration
# =============================================================================

# Gemini API Key (Required for ADK & Gemini Foundation Models)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GOOGLE_API_KEY is also supported interchangeably
# GOOGLE_API_KEY=your_google_api_key_here

# Model Selection (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# AWS Region Configuration (Optional for local testing; DuckDB & cached EC2 fallbacks are built-in)
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_METRICS_BUCKET=co2ops-aws-metrics
AWS_REPORTS_BUCKET=co2ops-aws-reports

# Climatiq API Key (Optional; built-in regional carbon estimator used if empty)
# CLIMATIQ_API_KEY=your_climatiq_api_key_here
