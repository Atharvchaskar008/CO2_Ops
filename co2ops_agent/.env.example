# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_METRICS_BUCKET=co2ops-aws-metrics
AWS_REPORTS_BUCKET=co2ops-aws-reports

# Amazon Bedrock LLM Configuration
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Climatiq API Key (Carbon emissions calculation)
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# Telemetry Operational Mode (DEMO_MODE=true for local simulation, DEMO_MODE=false for live AWS CloudWatch)
DEMO_MODE=true
