# =============================================================================
# CO2Ops - AWS Bedrock Environment Configuration
# =============================================================================

# AWS Region Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Foundation Model Configuration
# Primary recommended model: Anthropic Claude Sonnet 4.6 on Amazon Bedrock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# Alternative Cross-Region Inference Profiles (supported on Amazon Bedrock):
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Execution Telemetry Mode:
# DEMO_MODE=true  -> Uses local AWS EC2 benchmark dataset for deterministic demonstrations without AWS charges
# DEMO_MODE=false -> Queries live AWS EC2 instances and AWS CloudWatch CPU utilization telemetry
DEMO_MODE=true

# Optional Climatiq API Key for localized carbon calculation
# CLIMATIQ_API_KEY=your_climatiq_api_key_here
